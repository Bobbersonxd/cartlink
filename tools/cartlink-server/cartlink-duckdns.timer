# Installed to /etc/systemd/system by tools/cartlink-server/setup.sh.
[Unit]
Description=Cartlink: update the DuckDNS address every 5 minutes

[Timer]
OnBootSec=1min
OnUnitActiveSec=5min

[Install]
WantedBy=timers.target
