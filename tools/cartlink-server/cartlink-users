#!/usr/bin/env bash
# Copyright (C) 2026 Cartlink contributors. GNU GPL v3 or later (see COPYING).
#
# Manage the friends who can log in to the Cartlink game server.
#   cartlink-users add NAME            makes a random 5-word password, shows it
#                                      once, saves only its hash
#   cartlink-users add --choose NAME   you type the password (12+ characters)
#   cartlink-users remove NAME
#   cartlink-users list
# After a change Caddy is reloaded (sudo systemctl reload caddy).
# CARTLINK_ROOT overrides /srv/cartlink. Test hooks: CARTLINK_NO_RELOAD=1 skips
# the reload; CARTLINK_PASS_STDIN=1 makes --choose read the password once from
# stdin; CARTLINK_WORDLIST overrides the word list file.
set -euo pipefail

HERE=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
ROOT=${CARTLINK_ROOT:-/srv/cartlink}
USERS=$ROOT/users
WORDLIST=${CARTLINK_WORDLIST:-$HERE/eff_short_wordlist_1.txt}
WORDLIST_SHA256=8f5ca830b8bffb6fe39c9736c024a00a6a6411adb3f83a9be8bfeeb6e067ae69
WORDS=5       # 5 words from 1296: about 51 bits
MIN_CHOSEN=12

die() { echo "cartlink-users: $*" >&2; exit 1; }
usage() {
	echo "Usage: cartlink-users add [--choose] NAME | remove NAME | list" >&2
	exit 2
}

check_name() {
	[[ $1 =~ ^[A-Za-z0-9_-]{1,32}$ ]] ||
		die "name must be 1-32 letters, digits, _ or - (got '$1')"
}

need_users_file() {
	[[ ! -L $USERS ]] || die "$USERS is a symlink, refusing"
	[[ -f $USERS ]] || die "$USERS not found. Run setup.sh first."
}

has_user() { awk -v n="$1" '$1 == n { found = 1 } END { exit !found }' "$USERS"; }

# Rewrite the users file in place, so its owner, group (caddy) and mode stay
# (its folder is root's, so it can't be swapped for a new file). If the write
# fails, the old list is put back, so a failed write never empties it.
replace_users() { # replace_users NEWFILE
	local old
	old=$(mktemp)
	cat "$USERS" > "$old"
	if ! cat "$1" > "$USERS"; then
		cat "$old" > "$USERS" || true
		rm -f "$1" "$old"
		die "could not write $USERS, nothing changed"
	fi
	rm -f "$1" "$old"
}

reload_caddy() {
	if [[ ${CARTLINK_NO_RELOAD:-} == 1 ]]; then return; fi
	echo "Reloading Caddy (may ask for your password)..."
	sudo systemctl reload caddy
}

# A random number 0..N-1 from /dev/urandom (N <= 65536), without bias:
# 16-bit values from the top, incomplete stretch are thrown away.
rand_below() { # rand_below N
	local n=$1 limit v
	limit=$((65536 - 65536 % n))
	while :; do
		v=$(od -An -N2 -tu2 /dev/urandom | tr -d '[:space:]')
		[[ $v =~ ^[0-9]+$ ]] || die "could not read /dev/urandom"
		((v < limit)) && { echo $((v % n)); return; }
	done
}

# The word list: 1296 lines "<dice digits><TAB><word>" (EFF short list #1).
# Anything else (missing, changed: checked by its SHA-256) -> no list, and the
# base32 fallback is used.
load_words() {
	local -n out=$1
	local sum
	out=()
	[[ -f $WORDLIST && -r $WORDLIST ]] || return 0
	sum=$(sha256sum < "$WORDLIST" 2>/dev/null) || return 0
	[[ ${sum%% *} == "$WORDLIST_SHA256" ]] || return 0
	mapfile -t out < <(awk -F'\t' 'NF == 2 && $1 ~ /^[1-6]{4}$/ && $2 ~ /^[a-z][a-z-]*[a-z]$/ { print $2 }' "$WORDLIST")
	((${#out[@]} == 1296)) || out=()
}

make_password() {
	local -a list
	local i pw='' b32=ABCDEFGHIJKLMNOPQRSTUVWXYZ234567 bytes
	load_words list
	if ((${#list[@]})); then
		for ((i = 0; i < WORDS; i++)); do
			pw+=${pw:+-}${list[$(rand_below ${#list[@]})]}
		done
	else
		# 24 base32 characters (120 bits); 256 is a multiple of 32, so no bias.
		bytes=$(od -An -N24 -tu1 /dev/urandom) || die "could not read /dev/urandom"
		for i in $bytes; do pw+=${b32:$((i % 32)):1}; done
		((${#pw} == 24)) || die "could not read /dev/urandom"
	fi
	PASSWORD=$pw
}

read_password() {
	local p1 p2
	if [[ ${CARTLINK_PASS_STDIN:-} == 1 ]]; then
		IFS= read -r p1 || true
		p2=$p1
	else
		[[ -t 0 ]] || die "run this in a terminal (it asks for the password)"
		IFS= read -rs -p "Password for $1 ($MIN_CHOSEN+ characters): " p1; echo >&2
		IFS= read -rs -p "Same password again: " p2; echo >&2
	fi
	[[ $p1 == "$p2" ]] || die "the two passwords are different, nothing changed"
	((${#p1} >= MIN_CHOSEN)) || die "password must be at least $MIN_CHOSEN characters, nothing changed"
	[[ $p1 != *$'\n'* ]] || die "password can't contain a line break"
	PASSWORD=$p1
}

install_hint() {
	if command -v pacman >/dev/null; then echo "sudo pacman -S caddy"
	elif command -v apt-get >/dev/null; then echo "sudo apt install caddy"
	else echo "Cartlink's setup supports Arch and Debian/Ubuntu only"; fi
}

cmd_add() { # cmd_add NAME generate|choose
	local name=$1 how=$2 hash
	check_name "$name"
	need_users_file
	if has_user "$name"; then die "$name already exists (remove them first to change the password)"; fi
	command -v caddy >/dev/null || die "caddy is not installed ($(install_hint))"
	if [[ $how == choose ]]; then read_password "$name"; else make_password; fi
	# The password goes to caddy on stdin, never on the command line.
	hash=$(printf '%s\n' "$PASSWORD" | caddy hash-password 2>/dev/null) || die "caddy hash-password failed"
	[[ $hash =~ ^\$2[aby]\$[0-9]{2}\$[./A-Za-z0-9]{53}$ ]] || die "unexpected hash from caddy, nothing changed"
	# Appending never truncates, so a failed write can't empty the list.
	if [[ -s $USERS && -n $(tail -c1 "$USERS") ]]; then echo >> "$USERS"; fi
	printf '%s %s\n' "$name" "$hash" >> "$USERS" || die "could not write $USERS"
	echo "Added $name."
	warn_links
	if [[ $how == generate ]]; then
		echo "Password for $name: $PASSWORD"
		echo "This is shown only once. Send it to $name privately; only its hash is saved."
	fi
	unset PASSWORD
	reload_caddy
}

cmd_remove() {
	local name=$1 tmp
	check_name "$name"
	need_users_file
	has_user "$name" || die "no friend called $name"
	tmp=$(mktemp)
	awk -v n="$name" '$1 != n' "$USERS" > "$tmp"
	replace_users "$tmp"
	echo "Removed $name."
	reload_caddy
}

# Caddy's file_server follows links, so a link in games/ shows what it points
# to to every friend. Only a warning; nothing is changed.
warn_links() {
	local links
	[[ -d $ROOT/games && ! -L $ROOT/games ]] || return 0
	links=$(find "$ROOT/games" -type l -print 2>/dev/null | head -n 5)
	[[ -z $links ]] && return 0
	echo "WARNING: $ROOT/games has links in it. Caddy shows what they point to to every friend:" >&2
	printf '    %s\n' "$links" >&2
	echo "WARNING: remove them and copy the files in instead." >&2
}

cmd_list() {
	need_users_file
	warn_links
	awk 'NF { print $1 }' "$USERS"
}

case ${1:-} in
	add)
		if [[ $# == 2 && $2 != --choose ]]; then cmd_add "$2" generate
		elif [[ $# == 3 && $2 == --choose ]]; then cmd_add "$3" choose
		else usage; fi
		;;
	remove) [[ $# == 2 ]] || usage; cmd_remove "$2" ;;
	list) [[ $# == 1 ]] || usage; cmd_list ;;
	*) usage ;;
esac
